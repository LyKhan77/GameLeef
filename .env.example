# ============================================================================
# GAME LEEF - ENVIRONMENT CONFIGURATION (SUPABASE)
# ============================================================================
# Salin file ini menjadi .env.local untuk menghubungkan dengan Supabase asli.
# Jika belum diisi, Game Leef akan tetap berjalan normal dengan sistem Guest/Mock local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
